{
  "name": "faberpg",
  "private": true,
  "version": "0.1.0",
  "description": "Un piccolo mondo in cui abitare — RPG old-school, slow fantasy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "tsx scripts/screenshot.ts",
    "bake": "tsx scripts/bake-textures.ts",
    "app": "npm run build && electron .",
    "app:mac": "npm run build && electron-builder --mac zip --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "three": "^0.186.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "it.faberpg.piccolomondo",
    "productName": "Un piccolo mondo",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.role-playing-games",
      "target": [
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
